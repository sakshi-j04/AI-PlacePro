# AI PlacePro Backend Configuration
# Copy to .env and fill in values (optional)

# Database: SQLite by default (backend/instance/placepro.db)
# DATABASE_URI=sqlite:///instance/placepro.db

# Optional: OpenAI API key for LLM-based training plans
# OPENAI_API_KEY=

# Optional: Groq API key for LLM-based coding practice & study plans
# GROQ_API_KEY=

# Optional: Gemini API key for LLM-based study plans
# GEMINI_API_KEY=

# Optional: Secret key for production
# SECRET_KEY=your-secret-key-here
